  },
  "temporal_windowing_and_extraction": {
    "window_sec": 10.0,
    "stride_sec": 3.0,
    "overlap_ratio": 0.7,
    "segment_id_format": "{file_id}_s{index:05d}_{start_ms:09d}_{end_ms:09d}",
    "visual_keyframe": {
      "sampling_rule": "Exact midpoint of window: round(start_sec + (end_sec - start_sec) / 2.0, 3)",
      "resolution_rgb": [224, 224],
      "ffmpeg_filter": "scale=224:224",
      "jpeg_quality_qscale": 2
    },
    "speech_to_text_stt": {
      "engine": "faster-whisper",
      "model_size": "large-v3-turbo",
      "language": "id",
      "beam_size": 1,
      "vad_filter": true,
      "condition_on_previous_text": false,
      "audio_decode_format": "16000 Hz, mono, pcm_s16le",
      "context_prompt": "Lu kenapa sih, anjir, tolol banget, bego, bocil, caper, cupu, mati aja lo, bacot, najis, sialan, sok jagoan, viral."
    },
    "optical_character_recognition_ocr": {
      "engine": "EasyOCR",
      "languages": ["id", "en"],
      "detail_level": 0,
      "watermark_noise_patterns_removed": [
        "filmora",
        "capcut",
        "kinemaster",
        "inshot",
        "vn editor"
      ]
    },
    "acoustic_feature_extraction": {
      "representation": "waveform16_v1",
      "dimension": 16,
      "sample_rate_hz": 16000,
      "pcm_encoding": "signed little-endian 16-bit mono",
      "frame_length_samples": 400,
      "hop_length_samples": 160,
      "fft_length": 512,
      "window_function": "numpy.hanning symmetric",
      "rolloff_fraction": 0.85,
      "epsilon": 1e-10,
      "minimum_decoded_seconds": 0.25,
      "features": [
        "log10_rms_mean",
        "log10_rms_std",
        "absolute_peak",
        "absolute_mean",
        "zero_crossing_mean",
        "zero_crossing_std",
        "spectral_centroid_mean",
        "spectral_centroid_std",
        "spectral_bandwidth_mean",
        "spectral_bandwidth_std",
        "spectral_rolloff85_mean",
        "spectral_rolloff85_std",
        "spectral_flatness_mean",
        "spectral_flatness_std",
        "spectral_flux_mean",
        "audio_present"
      ]
    }
  },
  "deidentification_and_public_redaction": {
    "pseudonymisation_rules": {
      "master_id_format": "CB_MASTER_{index:05d}",
      "video_group_prefixes": ["FB_", "VID_", "LEG_"],
      "strip_at_mentions_regex": "@[A-Za-z0-9_.]+",
      "strip_urls_regex": "https?://\\S+|www\\.\\S+",
      "preserve_source_url_in_public": false,
      "preserve_author_handle_in_public": false
    },
    "public_csv_redaction_token": "[WITHHELD]",
    "dataset_master_masked_columns": [
      "raw_text_or_ocr",
      "visual_keyframe_path",
      "stt_audio_transcript",
      "source_url",
      "author_or_uploader",
      "context_topic",
      "collected_or_timestamp",
      "emojis_extracted"
    ],
    "multimodal_segments_masked_columns": [
      "frame_path",
      "stt_transcript",
      "ocr_text"
    ]
  }
}
