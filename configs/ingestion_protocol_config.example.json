      "Instagram",
      "TikTok",
      "YouTube",
      "X"
    ],
    "credentials_policy": "Environment variables only; never hardcode or commit API keys or access tokens",
    "required_env_placeholders": {
      "YouTube": "YOUTUBE_DATA_API_V3_KEY",
      "TikTok": "TIKTOK_RESEARCH_API_BEARER_TOKEN",
      "Facebook_Instagram": "META_GRAPH_API_ACCESS_TOKEN",
      "X": "X_API_V2_BEARER_TOKEN"
    },
    "seed_lexicon_reference": "Indonesian abusive and cyberbullying lexicon adapted from Ibrohim & Budi [2] and adolescent school/peer-conflict context keywords"
  },
  "corpus_cohorts": {
    "master_inventory_total": 13307,
    "standalone_comments_track": {
      "initial_records": 8906,
      "excluded_majority_3_of_5_low_consensus": 690,
      "excluded_text_hash_leakage_isolation": 20,
      "retained_high_agreement_records": 8196,
      "held_out_test_records": 1226
    },
    "multimodal_video_track": {
      "source_videos_total": 233,
      "initial_candidate_windows_10s_stride3s": 4401,
      "platform_window_distribution_4401": {
        "Instagram": 1420,
        "Facebook": 828,
        "TikTok": 754,
        "YouTube": 750,
        "X_Twitter": 649
      },
      "alignment_exclusions": 450,
      "retained_aligned_windows": 3951,
      "linked_source_groups": 214,
      "source_disjoint_outer_folds": 4
